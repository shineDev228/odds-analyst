# ---------------------------------------------------------------------------
# ODDS ANALYST — Modèle de configuration
# Copier ce fichier en « .env » puis renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être commité dans Git.
# ---------------------------------------------------------------------------

# --- Environnement ---------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris

# --- Base de données PostgreSQL -------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=odds_analyst
POSTGRES_USER=odds_analyst_app
POSTGRES_PASSWORD=a_generer

# Chaîne de connexion complète utilisée par l'API
DATABASE_URL=postgresql+psycopg://odds_analyst_app:a_generer@localhost:5432/odds_analyst

# Restauration (facultatif) : rôle autorisé à créer des bases. Nécessaire
# seulement si le compte applicatif ne possède pas le droit CREATEDB.
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=

# --- Sécurité --------------------------------------------------------------
# Générer avec : uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a_generer
SESSION_COOKIE_NAME=odds_analyst_session
# Expiration absolue : 24 h.
SESSION_MAX_AGE_SECONDS=86400
# Expiration d'inactivité : 12 h sans requête ferment la session.
SESSION_IDLE_SECONDS=43200
# `last_seen_at` n'est réécrit qu'après ce délai (limite les écritures).
SESSION_TOUCH_SECONDS=60
# À passer à true uniquement derrière HTTPS : ajoute le drapeau Secure aux
# cookies et active HSTS.
COOKIE_SECURE=false
HSTS_MAX_AGE_SECONDS=63072000

# Clé de chiffrement des clés API (Fernet). Générer avec :
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=a_generer

# --- Réseau ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
WEB_URL=http://localhost:3100
# L'interface appelle l'API via son proxy interne : même origine, cookies et
# CSRF sans CORS. Laisser « /api ».
NEXT_PUBLIC_API_URL=/api

# --- Journalisation --------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Connecteurs de données (Phase 7) --------------------------------------
# Clés lues uniquement ici, jamais exposées par l'API ni journalisées.
# Laisser vide désactive proprement le fournisseur correspondant.
BIGBALLSDATA_KEY=
THE_ODDS_API_KEY=
FOOTBALL_DATA_KEY=

# football-data.co.uk ne demande aucune clé : fichiers CSV publics, sans quota.
# L'adresse est facultative (valeur par défaut ci-dessous).
FOOTBALL_DATA_UK_BASE_URL=https://football-data.co.uk

# Budgets locaux (réserve déjà déduite).
BIGBALLSDATA_DAILY_BUDGET=200
THE_ODDS_API_MONTHLY_BUDGET=400
FOOTBALL_DATA_MINUTE_BUDGET=8

# Réseau et limites des imports.
CONNECTOR_TIMEOUT_SECONDS=15
CONNECTOR_MAX_RETRIES=2
CONNECTOR_PREVIEW_TTL_SECONDS=7200
CONNECTOR_MAX_EXTENDED_EVENTS=20
CONNECTOR_MAX_STATS_BATCH=10

